# --------------------------------------------------------------------------
# render / export
# --------------------------------------------------------------------------
def setup_lighting():
    sc = bpy.context.scene
    for ob in [o for o in bpy.data.objects if o.type in ("LIGHT", "CAMERA")]:
        bpy.data.objects.remove(ob, do_unlink=True)

    sd = bpy.data.lights.new("sun", "SUN")
    sd.energy = 5.0
    sd.angle = math.radians(2.0)
    sd.color = (1.0, 0.94, 0.82)
    so = bpy.data.objects.new("sun", sd)
    sc.collection.objects.link(so)
    so.rotation_euler = Euler((math.radians(48), 0, math.radians(197)), "XYZ")

    wd = sc.world
    if wd is None:
        wd = bpy.data.worlds.new("World")
        sc.world = wd
    wd.use_nodes = True
    nt = wd.node_tree
    bg = None
    for n in nt.nodes:
        if n.type == "BACKGROUND":
            bg = n
    if bg is None:
        bg = nt.nodes.new("ShaderNodeBackground")
    bg.inputs[0].default_value = (0.40, 0.55, 0.74, 1.0)
    bg.inputs[1].default_value = 0.50

    ad = bpy.data.lights.new("fill", "AREA")
    ad.energy = 620.0
    ad.size = 36.0
    ad.color = (0.72, 0.84, 1.0)
    ao = bpy.data.objects.new("fill", ad)
    sc.collection.objects.link(ao)
    ao.location = (-30.0, -40.0, 26.0)
    ao.rotation_euler = Euler((math.radians(58), 0, math.radians(35)), "XYZ")


def add_warm_fill(cam_loc, look_at):
    """Broad warm bounce from camera-left: the shadow side was going dead."""
    sc = bpy.context.scene
    ld = bpy.data.lights.new("warmfill", "AREA")
    ld.energy = 1100.0
    ld.size = 34.0
    ld.color = (1.0, 0.80, 0.58)
    lo = bpy.data.objects.new("warmfill", ld)
    sc.collection.objects.link(lo)
    cc = Vector(cam_loc)
    tt = Vector(look_at)
    d = (tt - cc).normalized()
    left = d.cross(Vector((0.0, 0.0, 1.0))).normalized()
    p = cc + left * 30.0 + Vector((0.0, 0.0, 12.0))
    lo.location = p
    lo.rotation_euler = (tt - p).to_track_quat("-Z", "Y").to_euler()
    return lo


def add_furnace_light(F, cfg):
    """One warm point light in the smelter mouth so it lights the yard."""
    sc = bpy.context.scene
    ld = bpy.data.lights.new("furnace_glow", "POINT")
    ld.energy = 260.0
    ld.color = (1.0, 0.45, 0.14)
    ld.shadow_soft_size = 1.2
    lo = bpy.data.objects.new("furnace_glow", ld)
    sc.collection.objects.link(lo)
    sm = cfg["smelter"]
    face = sm[2]
    M = F.M(sm[0], sm[1], 0.0, du=face[0], dv=face[1])
    p = M @ Vector((-0.5 * 0.0, 1.2, 1.5))
    # M is a rotated/translated frame: offset in local +Y (front) by 1.2
    p = (M @ Vector((0, 0, 0))) + (M.to_3x3() @ Vector((-0.5, 1.2, 1.5)))
    lo.location = p
    return lo


def setup_render(w=1280, h=720, samples=64):
    sc = bpy.context.scene
    try:
        sc.render.engine = "BLENDER_EEVEE"
    except TypeError:
        sc.render.engine = "BLENDER_EEVEE_NEXT"
    print("[render] engine=", sc.render.engine)
    sc.render.resolution_x = w
    sc.render.resolution_y = h
    sc.render.resolution_percentage = 100
    sc.render.film_transparent = False
    sc.render.image_settings.file_format = "PNG"
    for attr, val in (("taa_render_samples", samples), ("use_raytracing", True),
                      ("use_shadows", True), ("shadow_ray_count", 2),
                      ("shadow_step_count", 6)):
        try:
            setattr(sc.eevee, attr, val)
        except (AttributeError, TypeError):
            pass
    sc.view_settings.view_transform = "AgX"
    sc.view_settings.exposure = 0.85
    try:
        sc.view_settings.look = "AgX - Medium High Contrast"
    except TypeError:
        pass
    # glow on the emissive furnace / lanterns
    try:
        nt = None
        for attr in ("compositing_node_group", "node_tree"):
            nt = getattr(sc, attr, None)
            if nt is not None:
                break
        if nt is None:
            nt = bpy.data.node_groups.new("Comp", "CompositorNodeTree")
            sc.compositing_node_group = nt
        for n in list(nt.nodes):
            nt.nodes.remove(n)
        rl = nt.nodes.new("CompositorNodeRLayers")
        gl = nt.nodes.new("CompositorNodeGlare")
        gl.glare_type = "FOG_GLOW"
        gl.quality = "HIGH"
        gl.threshold = 1.0
        gl.size = 7
        cp = nt.nodes.new("CompositorNodeComposite")
        nt.links.new(rl.outputs["Image"], gl.inputs["Image"])
        nt.links.new(gl.outputs["Image"], cp.inputs["Image"])
        sc.render.use_compositing = True
    except Exception as exc:      # compositor API drift across versions
        print("[render] compositor skipped:", exc)


def setup_camera(loc, look_at, lens=35.0):
    sc = bpy.context.scene
    for ob in [o for o in bpy.data.objects if o.type == "CAMERA"]:
        bpy.data.objects.remove(ob, do_unlink=True)
    cd = bpy.data.cameras.new("cam")
    cd.lens = lens
    co = bpy.data.objects.new("cam", cd)
    sc.collection.objects.link(co)
    co.location = Vector(loc)
    d = Vector(look_at) - Vector(loc)
    co.rotation_euler = d.to_track_quat("-Z", "Y").to_euler()
    sc.camera = co
    return co


def render_to(path):
    d = os.path.dirname(path)
    if d:
        os.makedirs(d, exist_ok=True)
    bpy.context.scene.render.filepath = path
    bpy.ops.render.render(write_still=True)
    return path


# camera in LANE coordinates (u, v, z) -> converted to world in build_one
CAM = {
    "mine_a": ((-24.0, -50.0, 46.0), (18.0, 5.0, 3.0), 22.0),
    "mine_b": ((24.0, -50.0, 46.0), (-18.0, 5.0, 3.0), 22.0),
    "mine_c": ((-32.0, -58.0, 56.0), (14.0, 4.0, 3.0), 22.0),
}
_ov = os.environ.get("MINE_CAM")
if _ov:
    _p = [float(x) for x in _ov.split(",")]
    CAM["__override__"] = ((_p[0], _p[1], _p[2]), (_p[3], _p[4], _p[5]), _p[6])


def stats():
    meshes = [o for o in bpy.data.objects if o.type == "MESH"]
    tris = 0
    for o in meshes:
        me = o.data
        me.calc_loop_triangles()
        tris += len(me.loop_triangles)
    mats = set()
    for o in meshes:
        for m in o.data.materials:
            if m:
                mats.add(m.name)
    bb = [1e9, 1e9, 1e9, -1e9, -1e9, -1e9]
    for o in meshes:
        for v in o.data.vertices:
            p = o.matrix_world @ v.co
            bb[0] = min(bb[0], p.x); bb[1] = min(bb[1], p.y); bb[2] = min(bb[2], p.z)
            bb[3] = max(bb[3], p.x); bb[4] = max(bb[4], p.y); bb[5] = max(bb[5], p.z)
    faces = sum(len(o.data.polygons) for o in meshes)
    return dict(objects=len(meshes), faces=faces, tris=tris,
                materials=len(mats), bbox=bb)


def export_fbx(path):
    meshes = [o for o in bpy.data.objects if o.type == "MESH"]
    for ob in bpy.data.objects:
        ob.select_set(False)
    for ob in meshes:
        ob.select_set(True)
    bpy.context.view_layer.objects.active = meshes[0]
    kw = dict(filepath=path, use_selection=True, object_types={"MESH"},
              global_scale=1.0, apply_unit_scale=True, use_mesh_modifiers=True,
              axis_forward="-Z", axis_up="Y", mesh_smooth_type="FACE",
              path_mode="AUTO", embed_textures=False,
              bake_space_transform=False)
    bpy.ops.export_scene.fbx(**kw)
    return path


def build_one(name, do_render=True, do_export=True, do_save=True):
    cfg = VARIANTS[name]
    reset_scene()
    medkit._MAT_CACHE.clear()
    F = Frame(cfg["axis"], cfg["side"])

    t0 = time.time()
    build_variant(cfg)
    print("[mine] build %.1fs" % (time.time() - t0))

    setup_lighting()
    add_furnace_light(F, cfg)
    setup_render()
    t0 = time.time()
    if do_render:
        cu, look_u, lens = CAM.get("__override__" if os.environ.get("MINE_CAM") else name, CAM[name])
        loc = F.P(cu[0], cu[1], cu[2]) if len(cu) == 3 else cu
        look = F.P(look_u[0], look_u[1], look_u[2]) if len(look_u) == 3 else look_u
        setup_camera(loc, look, lens)
        add_warm_fill(loc, look)
        render_to(os.path.join(RENDER_DIR, name + ".png"))
        print("[mine] render %.1fs" % (time.time() - t0))

    st = stats()
    print("[mine] STATS %s" % name)
    print("   objects=%d  faces=%d  tris=%d  materials=%d"
          % (st["objects"], st["faces"], st["tris"], st["materials"]))
    print("   bbox x[%.2f %.2f] y[%.2f %.2f] z[%.2f %.2f]"
          % (st["bbox"][0], st["bbox"][3], st["bbox"][1], st["bbox"][4],
             st["bbox"][2], st["bbox"][5]))

    os.makedirs(EXPORT_DIR, exist_ok=True)
    if do_export:
        fbx = os.path.join(EXPORT_DIR, name + ".fbx")
        export_fbx(fbx)
        print("[mine] fbx=%s %d bytes" % (fbx, os.path.getsize(fbx)))
    if do_save:
        os.makedirs(SCRIPT_DIR, exist_ok=True)
        bpy.ops.wm.save_as_mainfile(filepath=os.path.join(SCRIPT_DIR, name + ".blend"))
        print("[mine] blend saved")
    return st


def main():
    args = sys.argv[sys.argv.index("--") + 1:] if "--" in sys.argv else []
    which = "mine_a"
    do_render = True
    for i, a in enumerate(args):
        if a == "--variant" and i + 1 < len(args):
            which = args[i + 1]
        if a == "--norender":
            do_render = False
    define_variants()
    os.makedirs(RENDER_DIR, exist_ok=True)
    os.makedirs(EXPORT_DIR, exist_ok=True)
    names = list(VARIANTS) if which == "all" else [which]
    for nm in names:
        build_one(nm, do_render=do_render)
    print("MINE_DONE", names)


if __name__ == "__main__":
    main()
